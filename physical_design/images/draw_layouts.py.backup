import re
import struct
import zlib
from pathlib import Path

BASE = Path.home() / "smart_parking_vlsi/physical_design/images"
W, H = 1400, 1000

def png_write(path, pixels):
    raw = b"".join(b"\x00" + bytes(pixels[y*W*3:(y+1)*W*3]) for y in range(H))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    data = (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6))
            + chunk(b"IEND", b""))
    Path(path).write_bytes(data)

def draw_rect(p, x1, y1, x2, y2, color):
    x1, x2 = sorted((max(0,min(W-1,int(x1))), max(0,min(W-1,int(x2)))))
    y1, y2 = sorted((max(0,min(H-1,int(y1))), max(0,min(H-1,int(y2)))))
    for y in range(y1, y2+1):
        for x in range(x1, x2+1):
            i = (y*W+x)*3
            p[i:i+3] = bytes(color)

def make_image(stage):
    text = (BASE / f"{stage}.def").read_text(errors="ignore")
    die = re.search(r"DIEAREA\s*\(\s*(-?\d+)\s+(-?\d+)\s*\)\s*\(\s*(-?\d+)\s+(-?\d+)\s*\)", text)
    core = re.search(r"COREAREA\s*\(\s*(-?\d+)\s+(-?\d+)\s*\)\s*\(\s*(-?\d+)\s+(-?\d+)\s*\)", text)
    if not die:
        print(f"{stage}: DIEAREA not found; skipped")
        return

    dx1, dy1, dx2, dy2 = map(int, die.groups())
    if dx2 <= dx1 or dy2 <= dy1:
        print(f"{stage}: invalid die area; skipped")
        return

    margin = 80
    scale = min((W-2*margin)/(dx2-dx1), (H-2*margin)/(dy2-dy1))
    def xy(x, y):
        return (margin+(x-dx1)*scale, H-margin-(y-dy1)*scale)

    p = bytearray([250, 250, 250] * W * H)
    a, b = xy(dx1, dy1); c, d = xy(dx2, dy2)
    draw_rect(p, a, d, c, b, (35, 39, 48))

    if core:
        cx1, cy1, cx2, cy2 = map(int, core.groups())
        a, b = xy(cx1, cy1); c, d = xy(cx2, cy2)
        draw_rect(p, a, d, c, b, (223, 231, 239))

    # Draw placed instance locations from the COMPONENTS section.
    m = re.search(r"COMPONENTS\s+\d+\s*;(.*?)END COMPONENTS", text, re.S)
    count = 0
    if m:
        for line in m.group(1).splitlines():
            q = re.search(r"\+\s+(?:PLACED|FIXED|COVER)\s+\(\s*(-?\d+)\s+(-?\d+)\s*\)", line)
            if not q:
                continue
            x, y = map(int, q.groups())
            px, py = xy(x, y)
            draw_rect(p, px-2, py-2, px+2, py+2, (20, 120, 210))
            count += 1

    # Draw routed wire segments when ROUTED geometry is present.
    routes = 0
    if stage == "routing":
        route_section = re.search(r"NETS\s+\d+\s*;(.*?)END NETS", text, re.S)
        if route_section:
            for net in route_section.group(1).splitlines():
                coords = re.findall(r"\(\s*(-?\d+)\s+(-?\d+)\s*\)", net)
                if len(coords) < 2 or "ROUTED" not in net and "NEW" not in net:
                    continue
                pts = [xy(int(x), int(y)) for x, y in coords]
                for (x1,y1),(x2,y2) in zip(pts, pts[1:]):
                    # Simple raster line
                    steps = max(1, int(max(abs(x2-x1), abs(y2-y1))))
                    for j in range(steps+1):
                        x = round(x1+(x2-x1)*j/steps)
                        y = round(y1+(y2-y1)*j/steps)
                        if 0 <= x < W and 0 <= y < H:
                            i = (y*W+x)*3
                            p[i:i+3] = bytes((210, 80, 65))
                routes += 1

    out = BASE / f"{stage}.png"
    png_write(out, p)
    print(f"Created {out} | instances drawn: {count} | routed nets scanned: {routes}")

for stage in ("floorplan", "placement", "cts", "routing"):
    make_image(stage)
